# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API (your deployed frontend URL, and http://localhost:3000 for dev)
CORS_ORIGIN=http://localhost:3000

# MongoDB Atlas connection string (free M0 cluster)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/trao-prep-kit

# Session auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Google Gemini (https://aistudio.google.com) - free tier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Tavily search (https://tavily.com) - free tier, used to look for public discussion of a company's interview process
TAVILY_API_KEY=

# Crawler behaviour
CRAWL_USER_AGENT=TraoPrepKitBot/1.0 (+https://github.com/<your-username>/<your-repo>)
CRAWL_MAX_PAGES_PER_SITE=8
CRAWL_REQUEST_TIMEOUT_MS=10000
CRAWL_MIN_DELAY_MS=500

# Set to "true" to allow fetching localhost/private-network URLs (needed for the evaluate command
# when it is pointed at a locally-served fixture site). Must stay false in production.
ALLOW_PRIVATE_NETWORK_FETCH=false
